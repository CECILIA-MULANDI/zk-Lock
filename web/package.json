{
  "name": "@zk-lock/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Browser demo for zk-Lock: generate a Groth16 proof locally and unlock a real Pudge cell with it.",
  "license": "MIT OR Apache-2.0",
  "scripts": {
    "sync:circuit": "node scripts/sync-circuit.mjs",
    "check:pipeline": "node scripts/check-pipeline.mjs",
    "build:sdk": "npm --prefix ../sdk/ts run build",
    "predev": "npm run build:sdk && npm run sync:circuit",
    "dev": "vite",
    "prebuild": "npm run build:sdk && npm run sync:circuit",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "shot": "node scripts/inspect.mjs"
  },
  "dependencies": {
    "@ckb-ccc/core": "^1.23.0",
    "@zk-lock/sdk": "file:../sdk/ts",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "snarkjs": "0.7.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0",
    "vite": "^8.3.5"
  }
}
